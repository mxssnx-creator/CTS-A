[Unit]
Description=CTS-A BingX x02 VST session (independent parallel)
After=network-online.target cts-a-desk.service
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=8

[Service]
Type=simple
EnvironmentFile=-/etc/cts-a/cts-a.env
EnvironmentFile=-/etc/cts-a/credentials.env
WorkingDirectory=/opt/cts-a
ExecStart=/usr/bin/node --max-old-space-size=384 --experimental-strip-types /opt/cts-a/scripts/cts-a-vst-session.mjs
Restart=always
RestartSec=8
RuntimeMaxSec=45000
TimeoutStartSec=180
TimeoutStopSec=20
OOMPolicy=kill
OOMScoreAdjust=-200
Environment=CTS_A_VST_HOURS=12
Environment=CTS_A_STATUS=/var/lib/cts-a/vst-session-x02.json
Environment=CTS_A_SETTINGS=/var/lib/cts-a/desk-settings-x02.json
Environment=CTS_A_OVERALL=/var/lib/cts-a/overall-stats-x02.json
Environment=CTS_A_DISABLED=/var/lib/cts-a/live-disabled-x02.json
Environment=CTS_A_PROTECT=/var/lib/cts-a/protect-grid-x02.json
Environment=CTS_A_CONN=bingx-vst-02
Environment=CTS_A_NETWORK=testnet
Environment=CTS_A_LIVE_MIN_PF=1
Environment=CTS_A_LIVE_MAX_POS=80
Environment=CTS_A_SYMBOLS=80
Environment=CTS_A_TICK_MS=1000
Environment=NODE_OPTIONS=--max-old-space-size=256
LimitNOFILE=4096
MemoryHigh=320M
MemoryMax=448M
TasksMax=64
StandardOutput=append:/var/log/cts-a/vst-x02.log
StandardError=append:/var/log/cts-a/vst-x02.err.log
SyslogIdentifier=cts-a-vst-x02

[Install]
WantedBy=multi-user.target
