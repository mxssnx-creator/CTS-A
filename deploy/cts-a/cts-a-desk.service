[Unit]
Description=CTS-A AXIS desk UI (:3202)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
EnvironmentFile=-/etc/cts-a/cts-a.env
EnvironmentFile=-/etc/cts-a/credentials.env
WorkingDirectory=/opt/cts-a
ExecStart=/opt/cts-a/deploy/cts-a/cts-a-desk.sh
Restart=always
RestartSec=4
TimeoutStartSec=120
TimeoutStopSec=20
KillMode=mixed
OOMPolicy=kill
Environment=NODE_ENV=development
Environment=HOST=0.0.0.0
Environment=PORT=3202
Environment=PATH=/opt/cts-a/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CTS_A_CONN=bingx-x01
Environment=CTS_A_NETWORK=mainnet
Environment=CTS_A_STATUS=/var/lib/cts-a/vst-session.json
Environment=CTS_A_SETTINGS=/var/lib/cts-a/desk-settings.json
Environment=CTS_A_OVERALL=/var/lib/cts-a/overall-stats.json
Environment=CTS_A_DISABLED=/var/lib/cts-a/live-disabled.json
Environment=CTS_A_PROTECT=/var/lib/cts-a/protect-grid.json
Environment=NODE_OPTIONS=--max-old-space-size=640
LimitNOFILE=4096
MemoryHigh=720M
MemoryMax=900M
TasksMax=128
StandardOutput=append:/var/log/cts-a/desk.log
StandardError=append:/var/log/cts-a/desk.err.log
SyslogIdentifier=cts-a-desk

[Install]
WantedBy=multi-user.target
