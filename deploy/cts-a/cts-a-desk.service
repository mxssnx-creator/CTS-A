[Unit]
Description=CTS-A AXIS desk UI (:3202)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
EnvironmentFile=-/etc/cts-a/cts-a.env
EnvironmentFile=-/etc/cts-a/credentials.env
WorkingDirectory=/opt/cts-a
ExecStart=/opt/cts-a/deploy/cts-a/cts-a-desk.sh
Restart=always
RestartSec=4
TimeoutStartSec=120
TimeoutStopSec=20
KillMode=mixed
OOMPolicy=kill
Environment=NODE_ENV=development
Environment=HOST=0.0.0.0
Environment=PORT=3202
Environment=PATH=/opt/cts-a/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LimitNOFILE=4096
MemoryHigh=900M
MemoryMax=1280M
TasksMax=128
StandardOutput=append:/var/log/cts-a/desk.log
StandardError=append:/var/log/cts-a/desk.err.log
SyslogIdentifier=cts-a-desk

[Install]
WantedBy=multi-user.target
